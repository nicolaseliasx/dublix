# Copy to .env (never commit it). Generate the key with: openssl rand -hex 32
SECRET_KEY=
# Public HTTPS address of this server, as Stremio and the setup site will reach it (for example your Cloudflare Tunnel hostname).
BASE_URL=https://filmhub.example.com
# The Filmhub setup site allowed to create profiles here from the browser.
FILMHUB_SITE_ORIGIN=https://filmhub.ncls.cc
# Gateway bind address and port. Keep 127.0.0.1 behind a tunnel (the setup site needs HTTPS to reach your server).
FILMHUB_BIND=127.0.0.1
FILMHUB_PORT=8080

# Regex/SEL access, private addresses and the allowed sync lists are fixed in compose.yaml on purpose.
# Per-IP rate limits for the stream endpoints (AIOStreams defaults are low for a household behind one address).
STREAM_API_RATE_LIMIT_WINDOW=10
STREAM_API_RATE_LIMIT_MAX_REQUESTS=120
STREMIO_STREAM_RATE_LIMIT_WINDOW=15
STREMIO_STREAM_RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=warn
