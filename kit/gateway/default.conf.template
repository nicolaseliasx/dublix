# Only what Stremio and the Dublix site need reaches AIOStreams. The configure UI and the rest of the API answer 404.
# Profile creation is open to anyone who reaches the gateway (that is how the setup site works): keep it slow.
limit_req_zone $binary_remote_addr zone=filmhub_create:1m rate=10r/m;
# Behind a tunnel the edge says https; on a direct connection use the real scheme.
map $http_x_forwarded_proto $filmhub_proto { default $http_x_forwarded_proto; "" $scheme; }

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 512k;

    # Both /stremio/configure and /stremio/<uuid>/<password>/configure (a plain prefix below so this regex is checked).
    location ~ ^/stremio/(configure|[^/]+/[^/]+/configure)(/|$) { return 404; }
    location /stremio/ { proxy_pass http://aiostreams:3000; include /etc/nginx/conf.d/proxy.inc; }
    location ^~ /api/v1/debrid/ { proxy_pass http://aiostreams:3000; include /etc/nginx/conf.d/proxy.inc; }
    location ^~ /static/ { proxy_pass http://aiostreams:3000; include /etc/nginx/conf.d/proxy.inc; }

    # Profile creation from the Dublix site (browser call, so CORS for that origin only).
    location = /api/v1/user {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "${FILMHUB_SITE_ORIGIN}" always;
            add_header Access-Control-Allow-Methods "POST" always;
            add_header Access-Control-Allow-Headers "content-type" always;
            add_header Access-Control-Max-Age 600 always;
            return 204;
        }
        if ($request_method != POST) { return 405; }
        limit_req zone=filmhub_create burst=5 nodelay;
        limit_req_status 429;
        add_header Access-Control-Allow-Origin "${FILMHUB_SITE_ORIGIN}" always;
        proxy_pass http://aiostreams:3000;
        include /etc/nginx/conf.d/proxy.inc;
    }
    location = /api/v1/status {
        if ($request_method != GET) { return 405; }
        add_header Access-Control-Allow-Origin "${FILMHUB_SITE_ORIGIN}" always;
        proxy_pass http://aiostreams:3000;
        include /etc/nginx/conf.d/proxy.inc;
    }

    location ^~ /subs/ {
        limit_except GET { deny all; }
        proxy_pass http://subs:18310/;
        proxy_read_timeout 15s;
    }

    location / { return 404; }
}
